{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/agent/[id]",
      "regex": "^/api/agent/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/agent/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/agent/[id]/events",
      "regex": "^/api/agent/([^/]+?)/events(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/agent/(?<nxtPid>[^/]+?)/events(?:/)?$"
    },
    {
      "page": "/api/auth/api-key/[provider]",
      "regex": "^/api/auth/api\\-key/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPprovider": "nxtPprovider"
      },
      "namedRegex": "^/api/auth/api\\-key/(?<nxtPprovider>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/auth/login/[provider]",
      "regex": "^/api/auth/login/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPprovider": "nxtPprovider"
      },
      "namedRegex": "^/api/auth/login/(?<nxtPprovider>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/auth/logout/[provider]",
      "regex": "^/api/auth/logout/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPprovider": "nxtPprovider"
      },
      "namedRegex": "^/api/auth/logout/(?<nxtPprovider>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/files/[...path]",
      "regex": "^/api/files/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/files/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/api/sessions/[id]",
      "regex": "^/api/sessions/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/sessions/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/sessions/[id]/context",
      "regex": "^/api/sessions/([^/]+?)/context(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/sessions/(?<nxtPid>[^/]+?)/context(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api/agent/new",
      "regex": "^/api/agent/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/agent/new(?:/)?$"
    },
    {
      "page": "/api/auth/all-providers",
      "regex": "^/api/auth/all\\-providers(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/all\\-providers(?:/)?$"
    },
    {
      "page": "/api/auth/providers",
      "regex": "^/api/auth/providers(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/providers(?:/)?$"
    },
    {
      "page": "/api/default-cwd",
      "regex": "^/api/default\\-cwd(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/default\\-cwd(?:/)?$"
    },
    {
      "page": "/api/home",
      "regex": "^/api/home(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/home(?:/)?$"
    },
    {
      "page": "/api/models",
      "regex": "^/api/models(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/models(?:/)?$"
    },
    {
      "page": "/api/models-config",
      "regex": "^/api/models\\-config(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/models\\-config(?:/)?$"
    },
    {
      "page": "/api/models-config/test",
      "regex": "^/api/models\\-config/test(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/models\\-config/test(?:/)?$"
    },
    {
      "page": "/api/sessions",
      "regex": "^/api/sessions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/sessions(?:/)?$"
    },
    {
      "page": "/api/sessions/new",
      "regex": "^/api/sessions/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/sessions/new(?:/)?$"
    },
    {
      "page": "/api/skills",
      "regex": "^/api/skills(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/skills(?:/)?$"
    },
    {
      "page": "/api/skills/install",
      "regex": "^/api/skills/install(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/skills/install(?:/)?$"
    },
    {
      "page": "/api/skills/search",
      "regex": "^/api/skills/search(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/skills/search(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}